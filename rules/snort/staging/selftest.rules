# =============================================================================
# detection-rules-lab functional self-test rules (Snort 3) — STAGING
# Matches the synthetic traffic from tests/generators/gen_pcaps.py.
# SID block 9000000-9000999 reserved for framework self-tests.
# =============================================================================

# Required-to-fire raw payload match (non-HTTP :4444 beacon flow, so pkt_data
# carries the raw marker on Snort 3 too).
alert tcp any any -> any any ( msg:"DRL FUNCTIONAL TCP PAYLOAD MARKER"; content:"drl-functional-test", nocase; classtype:policy-violation; sid:9000001; rev:1; metadata:author detection-rules-lab, created 2026_06_14; )

# Realistic HTTP buffer variant (Snort 3 sticky buffer syntax).
alert tcp any any -> any 80 ( msg:"DRL FUNCTIONAL HTTP URI MARKER"; flow:to_server,established; http_uri; content:"/drl-functional-test", nocase; classtype:policy-violation; sid:9000002; rev:1; metadata:author detection-rules-lab, created 2026_06_14; )

# =============================================================================
# detection-rules-lab functional self-test rules (Suricata) — STAGING
# These deliberately match the synthetic traffic from tests/generators/gen_pcaps.py
# (a non-HTTP :4444 beacon carrying "drl-functional-test", plus an HTTP GET to
# /drl-functional-test). SID block 9000000-9000999 is reserved for self-tests.
# =============================================================================

# Robust raw-payload match (matches the :4444 beacon flow) — REQUIRED to fire.
alert tcp any any -> any any (msg:"DRL FUNCTIONAL TCP PAYLOAD MARKER"; content:"drl-functional-test"; nocase; classtype:policy-violation; sid:9000001; rev:1; metadata:stage staging, author detection-rules-lab, created 2026_06_14, mitre_technique T1071_001;)

# Realistic app-layer variant — exercises HTTP reassembly + sticky buffer.
alert http any any -> any any (msg:"DRL FUNCTIONAL HTTP URI MARKER"; flow:established,to_server; http.uri; content:"/drl-functional-test"; nocase; classtype:policy-violation; sid:9000002; rev:1; metadata:stage staging, author detection-rules-lab, created 2026_06_14, mitre_technique T1071_001;)
